{
  "id": "ember-crucible-tempfix",
  "title": "Ember / Crucible 临时修补",
  "description": "针对 Crucible 系统与 Ember 模块上游若干数据/逻辑缺陷的运行时临时补丁：副手打击判据（含徒手手位）、凯思族撕咬范围、符文所授的小戏法与训练等级、疗愈导流的恢复资源、湮灭之印的非法效果 ID、强化护盾/雷法姆变身丢失的加值、排斥踢的永久踉跄、余烬之火的目标作用域、迷乱凝视的防御标签、反重力石的目标类型、暗焰头冠的非法标签。全部为运行时修补，不改动世界存盘数据；停用本模块即恢复原状（已生成的聊天卡保留当时的动作快照）。",
  "version": "0.2.0",
  "authors": [{ "name": "takaqiao" }],
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "14.999"
  },
  "relationships": {
    "systems": [
      {
        "id": "crucible",
        "type": "system",
        "compatibility": { "minimum": "0.10.0" }
      }
    ],
    "recommends": [
      {
        "id": "ember",
        "type": "module",
        "reason": "P2–P4 与 N1–N7 修的是 Ember 的数据/钩子；没装 Ember 时这些补丁不会命中任何动作，模块仍可安全启用。",
        "compatibility": { "minimum": "0.6.0" }
      }
    ]
  },
  "esmodules": ["scripts/tempfix.mjs"],
  "socket": false,
  "url": "https://github.com/takaqiao/ember-crucible-tempfix",
  "manifest": "https://github.com/takaqiao/ember-crucible-tempfix/releases/latest/download/module.json",
  "download": "https://github.com/takaqiao/ember-crucible-tempfix/releases/latest/download/module.zip",
  "readme": "https://github.com/takaqiao/ember-crucible-tempfix/blob/main/README.md",
  "changelog": "https://github.com/takaqiao/ember-crucible-tempfix/blob/main/CHANGELOG.md",
  "bugs": "https://github.com/takaqiao/ember-crucible-tempfix/issues",
  "license": "LICENSE"
}
